# Copiar a .env y completar con valores reales. Nunca commitear .env.
#
# Unica fuente de configuracion de base de datos: la app (Reflex), los
# repositorios y Alembic leen esta variable (D-011).
DATABASE_URL=mysql+pymysql://USUARIO:PASSWORD@localhost:3306/zapateria_db

# Administrador inicial: lo usa `seed.py` para crear la cuenta de admin
# (D-013). Sin estos valores el seed falla con un mensaje claro; nunca hay
# credenciales por defecto en el codigo.
ADMIN_EMAIL=admin@zapateria.com
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Galo Arnaudo
